(async function main() {
    // 添加延迟函数，避免请求过快
    const delay = ms => new Promise(resolve => setTimeout(resolve, ms));
    
    const zonesUrl = (page = 1) =>
        `https://dash.cloudflare.com/api/v4/zones?type=full,partial,secondary&per_page=100&page=${page}`;

    async function fetchJson(url, retries = 3) {
        for (let i = 0; i < retries; i++) {
            try {
                const res = await fetch(url, { 
                    credentials: "include",
                    headers: {
                        'Content-Type': 'application/json',
                        // 如果需要，添加认证头
                        // 'Authorization': 'Bearer YOUR_TOKEN'
                    }
                });
                
                if (!res.ok) {
                    // 如果是429（请求过多）或5xx错误，重试前等待
                    if (res.status === 429 || res.status >= 500) {
                        console.warn(`请求失败 ${res.status}，第${i+1}次重试...`);
                        await delay(1000 * (i + 1)); // 指数退避
                        continue;
                    }
                    throw new Error(`HTTP ${res.status} ${res.statusText}`);
                }
                
                return await res.json();
            } catch (err) {
                if (i === retries - 1) throw err;
                await delay(1000 * (i + 1));
            }
        }
    }

    try {
        const results = [];
        let page = 1;

        while (true) {
            console.log(`正在获取第 ${page} 页 zones...`);
            const zonesData = await fetchJson(zonesUrl(page));
            const zones = Array.isArray(zonesData.result) ? zonesData.result : [];
            
            if (zones.length === 0) {
                console.log('没有更多 zones');
                break;
            }

            // 使用 Promise.all 并发请求，但限制并发数
            const batchSize = 5; // 每次并发5个请求
            for (let i = 0; i < zones.length; i += batchSize) {
                const batch = zones.slice(i, i + batchSize);
                const batchPromises = batch.map(async (zone) => {
                    try {
                        const entitlementsUrl = `https://dash.cloudflare.com/api/v4/zones/${zone.id}/entitlements`;
                        const entData = await fetchJson(entitlementsUrl);
                        const entResults = Array.isArray(entData.result) ? entData.result : [];
                        const rule = entResults.find(r => r.feature?.key === "rulesets.snippets_rule_max");
                        const value = rule?.allocation?.value ?? 0;
                        
                        if (value > 0) {
                            return {
                                zone_id: zone.id,
                                zone_name: zone.name,
                                rulesets_snippets_rule_max: value
                            };
                        }
                    } catch (err) {
                        console.error(`获取 zone ${zone.name} (${zone.id}) 失败:`, err.message);
                        return null;
                    }
                });

                const batchResults = await Promise.all(batchPromises);
                results.push(...batchResults.filter(r => r !== null));
                
                // 每批请求后稍作延迟，避免触发速率限制
                if (i + batchSize < zones.length) {
                    await delay(500);
                }
            }

            // 检查分页信息
            const info = zonesData.result_info || {};
            console.log(`第 ${page} 页完成，共 ${results.length} 个有效结果`);
            
            // 分页结束条件
            if (!info.has_more && (!info.page || info.page >= info.total_pages)) {
                break;
            }
            
            page++;
            
            // 每页之间添加延迟
            await delay(1000);
        }

        // 输出格式化结果
        console.log('='.repeat(50));
        console.log('最终结果:');
        console.log(JSON.stringify(results, null, 2));
        console.log(`总计: ${results.length} 个 zones 拥有 snippets 规则`);
        
        // 输出统计信息
        if (results.length > 0) {
            const totalSnippets = results.reduce((sum, item) => sum + item.rulesets_snippets_rule_max, 0);
            const avgSnippets = totalSnippets / results.length;
            console.log(`总计 snippets 规则数量: ${totalSnippets}`);
            console.log(`平均每个 zone: ${avgSnippets.toFixed(2)}`);
            
            // 按 snippets 数量排序
            const sorted = [...results].sort((a, b) => b.rulesets_snippets_rule_max - a.rulesets_snippets_rule_max);
            console.log('\nTop 5 zones:');
            sorted.slice(0, 5).forEach((item, index) => {
                console.log(`${index + 1}. ${item.zone_name}: ${item.rulesets_snippets_rule_max}`);
            });
        }
        
    } catch (err) {
        console.error("请求失败:", err);
    }
})();
